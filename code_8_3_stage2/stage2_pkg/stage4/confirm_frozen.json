  "UNIF": "definitional values: budget confirmed, m_E = 1, Delta m_D = 0",
  "feasibility": "rejected if budget rejected or (lambda0 != none and m_E rejected); confirmed if budget confirmed and (lambda0 = none or m_E confirmed); else undecided",
  "sets": "challengers = confirmed feasible; c excluded if some challenger b has lower end of (dmD(b) - dmD(c)) > delta; candidate near-optimal set = feasibility not rejected and not excluded; groups: confirmed-feasible, feasibility-undecided"
 }
}